# -----------------------------------------------------------------------------
# AI Marketing & E-commerce Agent — environment template
#
#   cp .env.example .env
#
# Rules
# - NEVER commit real values. `.env` and `.env.*` are git-ignored (except this file).
# - Leave a value empty if you don't have it; the app falls back to safe defaults
#   (mock integrations, in-memory demo storage, live execution disabled).
# - Variables without the NEXT_PUBLIC_ prefix are server-only and never reach the
#   browser. Do not add NEXT_PUBLIC_ to anything secret.
# -----------------------------------------------------------------------------

# --- Application --------------------------------------------------------------
# Public base URL of the app (links and the Shopify OAuth callback). Must be https
# in production and must be the address you open the dashboard on.
APP_URL=http://localhost:3000
# Default dashboard language when the browser preference is unknown: en | ar
DEFAULT_LOCALE=en

# --- Database (PostgreSQL) ----------------------------------------------------
# Leave empty to run with in-memory demo storage (data resets on restart).
# Example for a local Postgres:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_marketing_agent?schema=public
DATABASE_URL=

# --- Security -----------------------------------------------------------------
# 32-byte key (base64) used to encrypt third-party credentials at rest.
# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Optional HTTP Basic Auth for preview deployments. When BOTH are set, every page
# and server action requires these credentials. Use a long random password.
DASHBOARD_BASIC_AUTH_USER=
DASHBOARD_BASIC_AUTH_PASSWORD=

# --- Safety guardrails --------------------------------------------------------
# Phase 1 has NO live adapters: execution of approved changes is always simulated.
# Keep this "false". Setting it to "true" does not bypass approvals, and is
# refused until live adapters exist and credentials/permissions are configured.
LIVE_EXECUTION_ENABLED=false
# Largest budget increase a single request may propose, in percent.
BUDGET_MAX_INCREASE_PERCENT=50
# Largest budget decrease a single request may propose, in percent.
BUDGET_MAX_DECREASE_PERCENT=80
# Hard ceiling for any proposed daily budget, in major currency units (e.g. USD).
BUDGET_MAX_DAILY_AMOUNT=5000
# Pending approval requests expire after this many hours.
APPROVAL_TTL_HOURS=72
# When "true", the person who requested a change cannot approve it (four-eyes rule).
# Recommended for production; off by default so the single demo user can try the flow.
REQUIRE_SEPARATE_APPROVER=false

# --- Meta Ads (Marketing API) — not used until the live adapter is built --------
META_APP_ID=
META_APP_SECRET=
# System-user access token with ads_read (and later ads_management) permission.
META_ACCESS_TOKEN=
# Ad account id including the "act_" prefix, e.g. act_1234567890
META_AD_ACCOUNT_ID=
# Graph API version you have tested against, e.g. vXX.0
META_API_VERSION=

# --- Shopify (Admin API, READ-ONLY) — see docs/SHOPIFY.md ------------------------
# Dev Dashboard app + authorization code grant. Connecting also requires
# DATABASE_URL, CREDENTIALS_ENCRYPTION_KEY and an https APP_URL. Add this exact
# redirect URL to the app version in the Dev Dashboard:
#   <APP_URL>/api/integrations/shopify/callback
# Dev Dashboard → your app → Settings → Client ID
SHOPIFY_CLIENT_ID=
# Dev Dashboard → your app → Settings → Secret. SECRET: server-side only.
SHOPIFY_CLIENT_SECRET=
# The one store this deployment may connect to, e.g. your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Pinned Admin API version (YYYY-01|04|07|10). Leave empty for the tested default 2026-10.
SHOPIFY_API_VERSION=

# --- Higgsfield AI — not used until the live adapter is built -------------------
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Base URL of the Higgsfield API you have access to.
HIGGSFIELD_API_BASE_URL=
